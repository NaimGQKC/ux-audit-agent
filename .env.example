# Asana integration
ASANA_ACCESS_TOKEN=           # Personal access token — https://app.asana.com/0/developer-console
ASANA_PROJECT_ID=             # GID of the target project (find it in the project URL)

# Slack integration (optional — enables /ux-audit slash command)
# Signing secret from https://api.slack.com/apps/{app_id}/general (Basic Information)
SLACK_SIGNING_SECRET=
# Public URL of this app — used for report links and internal audit invocation.
# In production set to your deployed URL, e.g. https://ux-audit.example.com
APP_URL=http://localhost:3000

# Google Stitch integration (optional — enables visual fix generation)
# Get your API key from the Stitch Settings page: https://stitch.googleapis.com/settings
# Then add Stitch to Claude Code: claude mcp add stitch --transport http https://stitch.googleapis.com/mcp --header "X-Goog-Api-Key: YOUR-KEY" -s user
STITCH_API_KEY=               # Stitch API key — required for "Generate Fix" features
STITCH_DESIGN_SYSTEM_ID=      # Optional — ID of an existing Stitch design system to reuse
